{
  "name": "yawana",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clean": "node scripts/clean-cache.js && expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:clean": "node scripts/clean-cache.js && expo start -c --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean:cache": "node scripts/clean-cache.js",
    "snapshots:backfill": "node scripts/backfill-snapshots.js",
    "alerts:backfill": "node scripts/backfill-alerts.js",
    "build:dev:android": "eas build --platform android --profile development",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:production:android": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.7",
    "@tanstack/react-query": "^5.25.0",
    "expo": "~55.0.24",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.33",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.4",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-modules-core": "~55.0.25",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "lucide-react-native": "^0.473.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "^1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "latest"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "private": true
}
